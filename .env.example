# Copy to .env and fill in. Never commit real values.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
FLASK_SECRET=change-me-to-a-long-random-string
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1/fyp

# Public address of the site. Required in production for links in emails
# (password reset links are never built from the request's Host header).
PUBLIC_BASE_URL=https://step.example.com

# --- Email (password reset and notifications) ---
# Without MAIL_SERVER, emails are written to the server log instead of sent.
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_USE_TLS=1
# MAIL_USE_SSL=0
# MAIL_DEFAULT_SENDER=STEP <no-reply@step.example.com>
# Email users about selections, submissions and reviews (in-app notifications always appear)
# MAIL_EVENT_EMAILS=1

# --- Student submissions ---
# Defaults to instance/submissions
# SUBMISSION_UPLOAD_DIR=
# SUBMISSION_MAX_FILE_MB=20

# --- AI Agents ---
# Server-side only; never exposed to the browser.
ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic
# AI_MODEL=claude-opus-5-5
# Reasoning depth: low | medium | high | xhigh | max
# AI_EFFORT=high
# AI_TIMEOUT_SECONDS=300
# Per-company cap on agent runs in any 24 hours (0 = unlimited)
# AI_MAX_RUNS_PER_DAY=50
# AI_MAX_FILE_MB=10
# AI_MAX_DOCUMENT_CHARS=100000
# AI_MAX_TOTAL_DOCUMENT_CHARS=200000
# Defaults to instance/ai_uploads. Must be shared storage if workers run on other machines.
# AI_UPLOAD_DIR=

# How runs execute: thread (default, background thread in the web process),
# worker (separate `flask --app app ai-agents worker` processes; use in production), inline (debugging)
# AI_EXECUTION_MODE=thread
# Fail runs stuck in "running" / "queued" after this many seconds
# AI_STALE_RUN_SECONDS=1800
# AI_QUEUE_TIMEOUT_SECONDS=3600

# Market Research agent: live web search (also enable web search for your Anthropic organisation)
# AI_WEB_SEARCH_ENABLED=1
# AI_WEB_SEARCH_MAX_USES=8
# AI_WEB_SEARCH_PRICE_PER_1K=10

# Data Analysis agent limits
# AI_DATA_MAX_ROWS=100000
# AI_DATA_MAX_COLUMNS=100
# Override cost estimates for AI_MODEL (USD per million tokens)
# AI_INPUT_PRICE_PER_MTOK=
# AI_OUTPUT_PRICE_PER_MTOK=
