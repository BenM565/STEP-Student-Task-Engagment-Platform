# Copy to .env for local development. Never commit the real .env.
# On Render, set these in the service's Environment tab (or declare them in
# render.yaml with `sync: false` so Render prompts for the values).

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Leave unset to fall back to a local SQLite file (instance/step.db).
# On Render, use the Postgres "Internal Database URL".
DATABASE_URL=

# Any long random string; sessions are invalidated when it changes.
SECRET_KEY=

# Required to register an admin account through the UI.
ADMIN_REGISTRATION_CODE=

# Public base URL used in outgoing email links (no trailing slash).
# Local: http://localhost:5000   Render: https://<service>.onrender.com
APP_URL=http://localhost:5000

# ---------------------------------------------------------------------------
# Email (see email_service.py)
# ---------------------------------------------------------------------------
# Provider: resend | smtp | console. Leave blank to auto-detect:
#   resend  if RESEND_API_KEY is set
#   smtp    if MAIL_SERVER and MAIL_USERNAME are set
#   console otherwise (emails are logged, not delivered; the app still runs)
# NOTE: Render FREE web services block outbound SMTP ports 25/465/587
# (since 26 Sep 2025). Use `resend` (HTTPS) on Render unless on a paid instance.
EMAIL_PROVIDER=

# Sender shown to recipients. With Resend this must be an address on a domain
# you have verified in Resend (or onboarding@resend.dev while testing, which
# can only deliver to the email address that owns the Resend account).
EMAIL_FROM=STEP Platform <no-reply@yourdomain.ie>
EMAIL_REPLY_TO=

# Resend: HTTPS API key from https://resend.com/api-keys
RESEND_API_KEY=

# SMTP relay: Gmail app password for local dev, or SendGrid / Mailgun / Brevo
# SMTP credentials, or an on-premises relay.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=

# Delivery tuning
# EMAIL_SYNC=1 sends inline instead of in a background thread (tests only).
EMAIL_SYNC=
EMAIL_WORKERS=2
# Task alerts go only to students sharing >= 1 skill tag with the task.
# Raise MIN_MATCH (0..1) to tighten; MAX_RECIPIENTS caps the fan-out per task.
EMAIL_TASK_ALERT_MIN_MATCH=0
EMAIL_TASK_ALERT_MAX_RECIPIENTS=100

# ---------------------------------------------------------------------------
# Optional: payments (Stripe)
# ---------------------------------------------------------------------------
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=10

# ---------------------------------------------------------------------------
# Optional: web push (VAPID)
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=
